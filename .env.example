# Phylax Syslog Service - Environment Configuration
# Universal template for local development and Docker deployment

# ============================================
# Node.js & Logging
# ============================================

# Environment: production, development, testing
# Recommended values:
#   development = local/docker dev
#   production  = docker production
NODE_ENV=production

# Log Level: trace, debug, info, warn, error, fatal
# Recommended values:
#   debug = development
#   info  = production (or warn)
LOG_LEVEL=info

# ============================================
# Syslog Service Configuration
# ============================================

# Port to listen on for syslog messages (RFC 3164)
# Default: 514 (standard syslog port)
# Local dev: 5514 (if port 514 requires sudo)
# Docker: 514 (usually fine)
SYSLOG_PORT=514

# UDP receive buffer size in bytes
# Default: 81920 (80 KB) - increase if receiving large messages
SYSLOG_UDP_BUFFER_SIZE=81920

# ============================================
# Log File Storage
# ============================================

# Directory where log files will be stored
# LOCAL DEV: ./logs (relative to project directory)
# DOCKER:    /var/log/syslog (mounted volume, must match docker-compose.yml)
# IMPORTANT: These values must match what's configured in docker-compose.yml
SYSLOG_LOG_DIR=./logs

# Maximum size of a single uncompressed log file in bytes
# Default: 52428800 (50 MB)
# When exceeded, file is rotated and queued for compression
SYSLOG_FILE_SIZE_LIMIT=52428800

# Unzipped file size limit (for internal checks)
# Default: 5242880 (5 MB)
SYSLOG_UNZIPPED_FILE_SIZE_LIMIT=5242880

# Date/time format for timestamps in log files
# Default: yyyy-MM-dd HH:mm:ss.fff
# Note: Timestamps always use local time (respecting TZ variable)
SYSLOG_DATE_TIME_FORMAT=yyyy-MM-dd HH:mm:ss.fff

# Log format: standard or extended
# standard:  TIMESTAMP HOSTNAME [TAG] MESSAGE
# extended:  RECEPTION_TIME SENDER_ADDRESS TIMESTAMP HOSTNAME [TAG] MESSAGE
SYSLOG_LOG_FORMAT=standard

# ============================================
# Syslog Service Timings
# ============================================

# How often to flush buffered messages to disk (milliseconds)
# Default: 5000 (5 seconds)
# Tuning:
#   5000  = balanced (default)
#   10000 = better performance, less frequent writes
#   2000  = fresher logs, more disk activity
SYSLOG_FLUSH_INTERVAL=5000

# Delay before processing day-switch event (milliseconds)
# Default: 15000 (15 seconds)
# Gives time for messages from previous day to arrive
SYSLOG_DAY_SWITCH_MESSAGE_DELAY=15000

# ============================================
# Message Quality Checks
# ============================================

# Maximum allowed processing delay (milliseconds)
# Default: 10000 (10 seconds)
# Messages arriving slower than this trigger a warning
SYSLOG_MAX_PROCESSING_DELAY=10000

# Maximum allowed reception delay (milliseconds)
# Default: 2000 (2 seconds)
# System delay before parsing
SYSLOG_MAX_RECEPTION_DELAY=2000

# Logger names that skip delay checking (comma-separated)
# These loggers may have legitimate delays
SYSLOG_NO_DELAY_CHECK_LOGGERS=

# ============================================
# Heartbeat Monitoring (Optional)
# ============================================

# Enable heartbeat sender (true/false)
# Local dev: false
# Production: true (recommended for health monitoring)
HEARTBEAT_ENABLED=false

# Port for sending heartbeat messages
# Default: 11514
HEARTBEAT_PORT=11514

# How often to send heartbeat messages (milliseconds)
# Default: 5000 (5 seconds)
HEARTBEAT_INTERVAL=5000

# Destination IP address for heartbeat messages
# Local dev: 127.0.0.1 (localhost)
# Production: <your-monitoring-server-ip>
HEARTBEAT_DESTINATION=127.0.0.1

# ============================================
# Log Retention
# ============================================

# How many days to keep compressed log archives
# Development: 30
# Production: 30-180 (adjust based on storage)
SYSLOG_LOG_RETENTION_DAYS=30

# ============================================
# Timezone
# ============================================

# Timezone for log timestamps (ensures LOCAL time, not UTC)
# Examples:
#   Europe/Berlin       # UTC+1/-+2 (winter/summer)
#   UTC                 # No conversion (use UTC)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Berlin

# ============================================
# SETUP GUIDE
# ============================================

# SCENARIO 1: Local Development (npm start)
# ============================================
# 1. cp .env.example .env
# 2. Edit .env:
#    NODE_ENV=development
#    LOG_LEVEL=debug
#    SYSLOG_PORT=5514
#    SYSLOG_LOG_DIR=./logs
# 3. npm install
# 4. npm start

# SCENARIO 2: Docker Development (docker-compose up)
# ============================================
# 1. cp .env.example .env
# 2. Optional edits:
#    NODE_ENV=development
#    LOG_LEVEL=debug
#    SYSLOG_LOG_DIR=/var/log/syslog (if different)
# 3. docker-compose up -d

# SCENARIO 3: Docker Production (docker-compose up)
# ============================================
# 1. cp .env.example .env
# 2. REQUIRED edits:
#    NODE_ENV=production
#    LOG_LEVEL=info
#    SYSLOG_LOG_DIR=/var/log/syslog (MUST match docker-compose.yml volume)
#    HEARTBEAT_ENABLED=true
#    HEARTBEAT_DESTINATION=<your-monitoring-server-ip>
#    TZ=<your-timezone>
#    SYSLOG_LOG_RETENTION_DAYS=90 (or more)
# 3. docker-compose up -d

# SCENARIO 4: Multiple Docker Environments (CI/CD)
# ============================================
# 1. Create separate .env files:
#    cp .env.example .env.dev
#    cp .env.example .env.staging
#    cp .env.example .env.prod
# 2. Edit each with environment-specific values
# 3. Deploy:
#    docker-compose --env-file .env.dev up -d
#    docker-compose --env-file .env.staging up -d
#    docker-compose --env-file .env.prod up -d
