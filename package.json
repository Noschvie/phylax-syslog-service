{
  "name": "phylax-syslog-service",
  "version": "1.0.0",
  "description": "Phylax Syslog Service - Node.js Edition. Containerized syslog receiver with automatic log rotation and compression.",
  "main": "src/index.js",
  "type": "module",
  "keywords": [
    "syslog",
    "rfc3164",
    "log-receiver",
    "docker",
    "nodejs"
  ],
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --testPathPattern='(config|syslogMessage|workQueue)\\.test\\.js'",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern='integration\\.test\\.js' --forceExit",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageReporters=text",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.js'",
    "docker:build": "docker build -t phylax-syslog:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "rm -rf logs/ node_modules/ dist/",
    "healthcheck": "node -e \"require('net').createConnection({port: 514}, ()=>process.exit(0)).on('error', ()=>process.exit(1))\"",
    "format:check": "prettier --check ."
  },
  "author": "Noschvie",
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "ini": "^7.0.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^7.2.2"
  }
}
