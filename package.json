{
  "name": "phylax-syslog-service",
  "version": "1.0.0-alpha",
  "description": "Phylax Syslog Service - Node.js Edition. Containerized syslog receiver with automatic log rotation and compression.",
  "main": "src/index.js",
  "type": "module",
  "keywords": [
    "syslog",
    "rfc3164",
    "log-receiver",
    "docker",
    "nodejs"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.js'",
    "docker:build": "docker build -t phylax-syslog:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "rm -rf logs/ node_modules/ dist/",
    "healthcheck": "node -e \"require('net').createConnection({port: 514}, ()=>process.exit(0)).on('error', ()=>process.exit(1))\""
  },
  "author": "Noschvie",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "archiver": "^6.0.1",
    "ini": "^4.1.1",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": [
      "airbnb-base"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": "warn"
    }
  }
}
