{
  "name": "phylax-syslog-service",
  "version": "1.0.0-alpha",
  "description": "Phylax Syslog Service - Node.js Edition. Containerized syslog receiver with automatic log rotation and compression.",
  "main": "src/index.js",
  "type": "module",
  "keywords": [
    "syslog",
    "rfc3164",
    "log-receiver",
    "docker",
    "nodejs"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageReporters=text",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.js'",
    "docker:build": "docker build -t phylax-syslog:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "rm -rf logs/ node_modules/ dist/",
    "healthcheck": "node -e \"require('net').createConnection({port: 514}, ()=>process.exit(0)).on('error', ()=>process.exit(1))\""
  },
  "author": "Noschvie",
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "ini": "^7.0.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^7.2.2"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": [
      "airbnb-base"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": "warn",
      "import/extensions": "off",
      "no-underscore-dangle": "off",
      "class-methods-use-this": "off"
    }
  }
}
